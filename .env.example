# Copy this file to .env.local for local development (vercel dev loads it automatically).
# In production, set this in the Vercel project's Environment Variables settings instead.

# Required. Server-side only — never exposed to the browser.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Powers the usage dashboard at /admin/usage.html. Without these two, logging is a
# silent no-op and the dashboard reports "not configured" — evaluate.js works fine either way.
# Add the free Upstash/Redis integration from Vercel's Marketplace (project Settings > Integrations)
# and it injects these automatically; or create a free DB directly at https://console.upstash.com
# and use its REST URL/token (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for the usage dashboard. Pick any long random string — this is the "password" the
# dashboard asks for, not an Anthropic key. Set it in Vercel's Environment Variables; there is
# no default and no recovery path other than changing it there.
ADMIN_DASHBOARD_KEY=
